  "components": [
    {
      "name": "Header Band",
      "kind": "nav",
      "refersTo": "header-band",
      "description": "Full-bleed printed teal band: editable game name left, outlined New game right.",
      "html": "<header class=\"ds-band\"><input class=\"ds-gname\" value=\"Rummikub\" aria-label=\"Game name\"><button class=\"ds-band-btn\">New game</button></header>",
      "css": ":host{--bg:#f7f8f7;--surface:#fff;--sunk:#f0f4f2;--ink:#1d2523;--graphite:#384140;--muted:#56645f;--line:#d3e4de;--field-line:#74867f;--accent:#0e6b5c;--accent-ink:#fff;--accent-soft:#dff0eb;--band-line:rgba(255,255,255,.45);--t0:#c62f2f;--t1:#1f5fbf;--t2:#a35c00;--t3:#1d1d1d;--bad:#c23a2b;--good:#1b7a43}.ds-band{display:flex;gap:10px;align-items:center;background:var(--accent);color:var(--accent-ink);padding:16px}.ds-gname{flex:1;min-width:0;font-family:\"Archivo\",system-ui,sans-serif;font-stretch:84%;font-weight:700;font-size:1.5rem;letter-spacing:-.01em;background:transparent;border:0;border-bottom:2px dashed transparent;color:inherit;padding:2px 0}.ds-gname:hover,.ds-gname:focus{border-bottom-color:var(--band-line);outline:none}.ds-band-btn{font:700 .88rem \"Figtree\",system-ui,sans-serif;background:transparent;color:inherit;border:1px solid var(--band-line);border-radius:10px;padding:6px 12px;min-height:44px;cursor:pointer}.ds-band-btn:focus-visible{outline:3px solid var(--accent-ink);outline-offset:2px}"
    },
    {
      "name": "Underline Tabs",
      "kind": "nav",
      "refersTo": "tab",
      "description": "Five equal tabs on a 2px rule; the selected tab is ink with a 3px teal underline.",
      "html": "<nav class=\"ds-tabs\" role=\"tablist\"><button role=\"tab\" aria-selected=\"true\">Scores</button><button role=\"tab\" aria-selected=\"false\">Rounds</button><button role=\"tab\" aria-selected=\"false\">Timer</button><button role=\"tab\" aria-selected=\"false\">Players</button><button role=\"tab\" aria-selected=\"false\">History</button></nav>",
      "css": ":host{--bg:#f7f8f7;--surface:#fff;--sunk:#f0f4f2;--ink:#1d2523;--graphite:#384140;--muted:#56645f;--line:#d3e4de;--field-line:#74867f;--accent:#0e6b5c;--accent-ink:#fff;--accent-soft:#dff0eb;--band-line:rgba(255,255,255,.45);--t0:#c62f2f;--t1:#1f5fbf;--t2:#a35c00;--t3:#1d1d1d;--bad:#c23a2b;--good:#1b7a43}.ds-tabs{display:flex;justify-content:space-between;gap:6px;border-bottom:2px solid var(--line);background:var(--bg);padding-top:6px}.ds-tabs button{font:700 .9rem \"Figtree\",system-ui,sans-serif;color:var(--muted);background:transparent;border:0;border-radius:0;border-bottom:3px solid transparent;margin-bottom:-2px;padding:10px 2px 9px;min-height:44px;cursor:pointer}.ds-tabs button:hover{color:var(--ink)}.ds-tabs button[aria-selected=\"true\"]{color:var(--ink);border-bottom-color:var(--accent)}.ds-tabs button:focus-visible{outline:3px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Score Board",
      "kind": "custom",
      "refersTo": "score-row",
      "description": "Column heads over a teal rule, ruled rows with rank, outlined initial box, name with gap line, graphite total; the leader total carries the pencil ring.",
      "html": "<div class=\"ds-board\"><div class=\"ds-colhead\"><span class=\"ds-c1\">#</span><span class=\"ds-c2\">Player · 3 rounds</span><span>Total</span></div><ol><li class=\"ds-row\"><span class=\"ds-rank\">1</span><span class=\"ds-tile\" style=\"--pc:var(--t0)\">A</span><span class=\"ds-name\">Ana<span class=\"ds-gap\">Leading</span></span><span class=\"ds-total\">27<svg class=\"ds-ring\" viewBox=\"0 0 100 60\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><path pathLength=\"100\" d=\"M60 6 C 30 2, 6 12, 6 30 C 6 50, 40 57, 66 54 C 92 51, 97 34, 92 20 C 88 9, 70 3, 48 7\"/></svg></span></li><li class=\"ds-row\"><span class=\"ds-rank\">2</span><span class=\"ds-tile\" style=\"--pc:var(--t2)\">D</span><span class=\"ds-name\">Dee<span class=\"ds-gap\">29 behind</span></span><span class=\"ds-total\">−2</span></li><li class=\"ds-row\"><span class=\"ds-rank\">3</span><span class=\"ds-tile\" style=\"--pc:var(--t1)\">M</span><span class=\"ds-name\">Marcus<span class=\"ds-gap\">43 behind</span></span><span class=\"ds-total ds-neg\">−16</span></li></ol></div>",
      "css": ":host{--bg:#f7f8f7;--surface:#fff;--sunk:#f0f4f2;--ink:#1d2523;--graphite:#384140;--muted:#56645f;--line:#d3e4de;--field-line:#74867f;--accent:#0e6b5c;--accent-ink:#fff;--accent-soft:#dff0eb;--band-line:rgba(255,255,255,.45);--t0:#c62f2f;--t1:#1f5fbf;--t2:#a35c00;--t3:#1d1d1d;--bad:#c23a2b;--good:#1b7a43}.ds-board{background:var(--bg);color:var(--ink);font-family:\"Figtree\",system-ui,sans-serif;padding:14px 16px}.ds-board ol{list-style:none;margin:0;padding:0}.ds-colhead{display:flex;align-items:flex-end;gap:12px;padding:0 4px 6px;border-bottom:2px solid var(--accent)}.ds-colhead span{font-family:\"Oswald\",\"Archivo\",system-ui,sans-serif;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);font-size:.74rem}.ds-c1{width:1.6rem;text-align:center}.ds-c2{flex:1}.ds-row{display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--line);padding:14px 4px}.ds-rank{width:1.6rem;text-align:center;font-family:\"Oswald\",sans-serif;font-weight:600;font-size:1.02rem;color:var(--muted);font-variant-numeric:tabular-nums}.ds-tile{flex:none;width:2.1rem;height:2.1rem;display:grid;place-items:center;border:1.5px solid var(--pc);border-radius:7px;color:var(--pc);font-family:\"Archivo\",system-ui,sans-serif;font-stretch:84%;font-weight:700;font-size:1rem}.ds-name{flex:1;min-width:0;font-weight:800;font-size:1.1rem}.ds-gap{display:block;font-size:.82rem;font-weight:600;color:var(--muted);margin-top:1px}.ds-total{position:relative;font-family:\"Archivo\",system-ui,sans-serif;font-stretch:84%;font-weight:700;font-size:2rem;letter-spacing:-.01em;color:var(--graphite);font-variant-numeric:tabular-nums;padding:0 8px;margin-right:6px}.ds-neg{color:var(--bad)}.ds-ring{position:absolute;left:-14px;top:-9px;width:calc(100% + 28px);height:calc(100% + 18px);overflow:visible;pointer-events:none}.ds-ring path{fill:none;stroke:var(--accent);stroke-width:2.4;stroke-linecap:round;vector-effect:non-scaling-stroke;stroke-dasharray:100;stroke-dashoffset:100;animation:ds-pencil .7s cubic-bezier(.5,0,.3,1) .1s forwards}@keyframes ds-pencil{to{stroke-dashoffset:0}}@media (prefers-reduced-motion:reduce){.ds-ring path{animation:none;stroke-dashoffset:0}}"
    },
    {
      "name": "Outlined Initial Boxes",
      "kind": "custom",
      "refersTo": "initial-box",
      "description": "Player marks in the four tile colours: outline and letter in the colour, transparent ground.",
      "html": "<div class=\"ds-tiles\"><span class=\"ds-tile\" style=\"--pc:var(--t0)\">A</span><span class=\"ds-tile\" style=\"--pc:var(--t1)\">M</span><span class=\"ds-tile\" style=\"--pc:var(--t2)\">D</span><span class=\"ds-tile\" style=\"--pc:var(--t3)\">J</span><span class=\"ds-tile ds-sm\" style=\"--pc:var(--t0)\">An</span></div>",
      "css": ":host{--bg:#f7f8f7;--surface:#fff;--sunk:#f0f4f2;--ink:#1d2523;--graphite:#384140;--muted:#56645f;--line:#d3e4de;--field-line:#74867f;--accent:#0e6b5c;--accent-ink:#fff;--accent-soft:#dff0eb;--band-line:rgba(255,255,255,.45);--t0:#c62f2f;--t1:#1f5fbf;--t2:#a35c00;--t3:#1d1d1d;--bad:#c23a2b;--good:#1b7a43}.ds-tiles{display:flex;gap:10px;align-items:center;padding:12px;background:var(--bg)}.ds-tile{width:2.1rem;height:2.1rem;display:grid;place-items:center;border:1.5px solid var(--pc);border-radius:7px;color:var(--pc);background:transparent;font-family:\"Archivo\",system-ui,sans-serif;font-stretch:84%;font-weight:700;font-size:1rem}.ds-sm{width:1.7rem;height:1.7rem;border-radius:6px;font-size:.7rem}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Teal fill for the main action; the full-width bottom-bar version is \"+ Score a round\".",
      "html": "<button class=\"ds-btn ds-primary\">+ Score a round</button>",
      "css": ":host{--bg:#f7f8f7;--surface:#fff;--sunk:#f0f4f2;--ink:#1d2523;--graphite:#384140;--muted:#56645f;--line:#d3e4de;--field-line:#74867f;--accent:#0e6b5c;--accent-ink:#fff;--accent-soft:#dff0eb;--band-line:rgba(255,255,255,.45);--t0:#c62f2f;--t1:#1f5fbf;--t2:#a35c00;--t3:#1d1d1d;--bad:#c23a2b;--good:#1b7a43}.ds-btn{font:700 .95rem \"Figtree\",system-ui,sans-serif;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:10px;padding:10px 14px;cursor:pointer}.ds-primary{width:100%;background:var(--accent);color:var(--accent-ink);border-color:var(--accent);padding:16px;border-radius:12px;font-family:\"Archivo\",system-ui,sans-serif;font-stretch:84%;font-weight:700;font-size:1.1rem}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid var(--accent);outline-offset:2px}.ds-btn:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Sheet-white outlined button for secondary actions.",
      "html": "<button class=\"ds-btn\">Add player</button>",
      "css": ":host{--bg:#f7f8f7;--surface:#fff;--sunk:#f0f4f2;--ink:#1d2523;--graphite:#384140;--muted:#56645f;--line:#d3e4de;--field-line:#74867f;--accent:#0e6b5c;--accent-ink:#fff;--accent-soft:#dff0eb;--band-line:rgba(255,255,255,.45);--t0:#c62f2f;--t1:#1f5fbf;--t2:#a35c00;--t3:#1d1d1d;--bad:#c23a2b;--good:#1b7a43}.ds-btn{font:700 .95rem \"Figtree\",system-ui,sans-serif;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:10px;padding:10px 14px;cursor:pointer}.ds-btn:hover{border-color:var(--field-line)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Two-tap Danger Button",
      "kind": "button",
      "refersTo": "button-armed",
      "description": "Red-pencil text at rest; armed (filled red) after the first tap, confirmed by the second.",
      "html": "<div class=\"ds-row2\"><button class=\"ds-btn ds-danger\">Delete round</button><button class=\"ds-btn ds-armed\">Tap again to delete</button></div>",
      "css": ":host{--bg:#f7f8f7;--surface:#fff;--sunk:#f0f4f2;--ink:#1d2523;--graphite:#384140;--muted:#56645f;--line:#d3e4de;--field-line:#74867f;--accent:#0e6b5c;--accent-ink:#fff;--accent-soft:#dff0eb;--band-line:rgba(255,255,255,.45);--t0:#c62f2f;--t1:#1f5fbf;--t2:#a35c00;--t3:#1d1d1d;--bad:#c23a2b;--good:#1b7a43}.ds-row2{display:flex;gap:8px;flex-wrap:wrap}.ds-btn{font:700 .95rem \"Figtree\",system-ui,sans-serif;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:10px;padding:10px 14px;cursor:pointer}.ds-danger{color:var(--bad)}.ds-armed{background:var(--bad);color:#fff;border-color:var(--bad)}.ds-btn:focus-visible{outline:3px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Sheet-white field with a darker field rule; teal border and wash halo on focus.",
      "html": "<input class=\"ds-field\" placeholder=\"Player name\">",
      "css": ":host{--bg:#f7f8f7;--surface:#fff;--sunk:#f0f4f2;--ink:#1d2523;--graphite:#384140;--muted:#56645f;--line:#d3e4de;--field-line:#74867f;--accent:#0e6b5c;--accent-ink:#fff;--accent-soft:#dff0eb;--band-line:rgba(255,255,255,.45);--t0:#c62f2f;--t1:#1f5fbf;--t2:#a35c00;--t3:#1d1d1d;--bad:#c23a2b;--good:#1b7a43}.ds-field{font:400 16px \"Figtree\",system-ui,sans-serif;color:var(--ink);background:var(--surface);border:1px solid var(--field-line);border-radius:8px;padding:10px 12px}.ds-field:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft)}"
    },
    {
      "name": "Display Setting",
      "kind": "chip",
      "refersTo": "segmented",
      "description": "Auto / Light / Dark segmented control; the selected option is a raised sheet-white tab.",
      "html": "<div class=\"ds-seg\" role=\"group\" aria-label=\"Light or dark\"><button aria-pressed=\"true\">Auto</button><button aria-pressed=\"false\">Light</button><button aria-pressed=\"false\">Dark</button></div>",
      "css": ":host{--bg:#f7f8f7;--surface:#fff;--sunk:#f0f4f2;--ink:#1d2523;--graphite:#384140;--muted:#56645f;--line:#d3e4de;--field-line:#74867f;--accent:#0e6b5c;--accent-ink:#fff;--accent-soft:#dff0eb;--band-line:rgba(255,255,255,.45);--t0:#c62f2f;--t1:#1f5fbf;--t2:#a35c00;--t3:#1d1d1d;--bad:#c23a2b;--good:#1b7a43}.ds-seg{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:4px;background:var(--sunk);border-radius:10px}.ds-seg button{font:700 1rem \"Figtree\",system-ui,sans-serif;border:0;background:transparent;color:var(--muted);border-radius:9px;padding:10px;cursor:pointer}.ds-seg button:hover{color:var(--ink)}.ds-seg button[aria-pressed=\"true\"]{background:var(--surface);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.15),inset 0 0 0 1px var(--field-line)}.ds-seg button:focus-visible{outline:3px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Timer Presets",
      "kind": "chip",
      "refersTo": "segmented-active",
      "description": "Pill chips with tabular figures; selected adds teal border, inset ring and teal wash.",
      "html": "<div class=\"ds-presets\"><button aria-pressed=\"false\">0:30</button><button aria-pressed=\"true\">1:00</button><button aria-pressed=\"false\">2:00</button></div>",
      "css": ":host{--bg:#f7f8f7;--surface:#fff;--sunk:#f0f4f2;--ink:#1d2523;--graphite:#384140;--muted:#56645f;--line:#d3e4de;--field-line:#74867f;--accent:#0e6b5c;--accent-ink:#fff;--accent-soft:#dff0eb;--band-line:rgba(255,255,255,.45);--t0:#c62f2f;--t1:#1f5fbf;--t2:#a35c00;--t3:#1d1d1d;--bad:#c23a2b;--good:#1b7a43}.ds-presets{display:flex;gap:6px;flex-wrap:wrap}.ds-presets button{font:700 1rem \"Figtree\",system-ui,sans-serif;font-variant-numeric:tabular-nums;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:999px;padding:7px 13px;min-height:44px;cursor:pointer}.ds-presets button[aria-pressed=\"true\"]{border-color:var(--accent);background:var(--accent-soft);color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}.ds-presets button:focus-visible{outline:3px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Turn Timer Dial",
      "kind": "custom",
      "refersTo": "timer-run",
      "description": "Full-screen dark timer: radial glow, track and progress arc in the state ring colour, huge tabular numeral.",
      "html": "<div class=\"ds-tmr\" data-state=\"run\"><div class=\"ds-dial\"><svg viewBox=\"0 0 100 100\" aria-hidden=\"true\"><circle class=\"ds-trk\" cx=\"50\" cy=\"50\" r=\"46\"/><circle class=\"ds-arc\" cx=\"50\" cy=\"50\" r=\"46\" pathLength=\"100\" style=\"stroke-dasharray:62 100\"/></svg><span class=\"ds-num\">38</span></div></div>",
      "css": ".ds-tmr{--tbg:#0b2b25;--ring:#3db49a;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 50% 45%,color-mix(in srgb,var(--ring) 22%,var(--tbg)),var(--tbg) 70%);color:#fff;transition:background .25s}.ds-tmr[data-state=\"warn\"]{--tbg:#3a2105;--ring:#f2a744}.ds-tmr[data-state=\"warn\"] .ds-num{color:#ffd58a}.ds-tmr[data-state=\"up\"]{--tbg:#4a100d;--ring:#f06b60}.ds-tmr[data-state=\"paused\"]{--tbg:#161d1b;--ring:#93a39e}.ds-dial{position:relative;width:220px;aspect-ratio:1;display:grid;place-items:center}.ds-dial svg{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}.ds-dial circle{fill:none;stroke-width:5}.ds-trk{stroke:rgba(255,255,255,.14)}.ds-arc{stroke:var(--ring);stroke-linecap:round}.ds-num{font-family:\"Archivo\",system-ui,sans-serif;font-stretch:84%;font-weight:700;font-size:96px;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}"
    }
  ],
  "narrative": {
    "northStar": "The Family Score Pad",
    "overview": "The app is the score pad that lives in the game drawer: a printed form in one teal ink, filled in by hand in graphite pencil. Everything printed (the header band, the column heads, the rules under them, the active-tab underline) is teal. Everything written by the scorekeeper (totals, round values, player names) is graphite or ink. The leader's total is circled in pencil, and the circle is drawn again whenever the lead changes hands.\n\nIt is one narrow column, built to be held in one hand and glanced at from across the table. Rows are separated by ruled lines, not boxed into cards. Players are marked with outlined initial boxes in the four tile colours (red, blue, orange, black), so a player can be found by colour before their name is read. Density is calm: a few ranked rows, very large tabular totals, and a pinned \"+ Score a round\" bar at the thumb.\n\nThe world rejects the stock card-list scoreboard: rounded white cards on grey, pill-shaped tabs, a filled highlight behind the leader. It avoids childish, busy, flashy or overly serious registers. It follows the phone's light and dark setting, with a manual override.",
    "keyCharacteristics": [
      "Printed teal for the form, graphite for the filled-in values, red pencil for negatives.",
      "One column, max 720px, 16px gutters, ruled rows.",
      "Semi-condensed Archivo numerals (84% width) with tabular figures for every score.",
      "Oswald small-caps column heads in teal over a 2px teal rule.",
      "Outlined initial boxes in four tile colours.",
      "The pencil ring around the leader's total is the signature.",
      "Light pad (near-white) and night pad (deep green-black); the timer is always dark."
    ],
    "rules": [
      {
        "name": "The One Ink Rule",
        "body": "Printed parts of the form (band, heads, rules, underline, ring, focus) are teal and only teal. Nothing else on the pad gets a brand colour.",
        "section": "colors"
      },
      {
        "name": "The Pencil Rule",
        "body": "Numbers the scorekeeper wrote are graphite. Negatives switch to red pencil. Totals are never teal and never sit on a coloured fill.",
        "section": "colors"
      },
      {
        "name": "The Tile Colours Are Names Rule",
        "body": "The four tile colours mark players and nothing else. They never carry status, ranking or emphasis.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every score, total, rank and timer value uses tabular figures, so columns of numbers line up like a ruled form.",
        "section": "typography"
      },
      {
        "name": "The Narrow Numeral Rule",
        "body": "Archivo is always set at 84% width when it is used for headings or numbers. It never appears at full width.",
        "section": "typography"
      },
      {
        "name": "The Flat Pad Rule",
        "body": "Nothing on the pad casts a shadow. Only sheets and the controls inside them are lifted, and only by a small amount.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do draw every printed element (band, heads, rules, active underline, ring, focus) in Printed Teal and nothing else.",
      "Do write numbers in Graphite, with tabular figures, in Archivo at 84% width; switch to Red Pencil for negatives.",
      "Do separate list items with 1px ruled lines on the pad; save bordered 10px containers for cards, tables and history entries.",
      "Do mark players with outlined initial boxes in their tile colour (colour index mod 4).",
      "Do mark the leader with the pencil ring only, redrawn when the lead changes and shown complete under reduced motion.",
      "Do put column and table heads in Oswald 600 uppercase at 0.08em tracking, teal, over a 2px teal rule.",
      "Do define every colour as a token in both the light block and the two dark blocks (`prefers-color-scheme` without `data-theme=\"light\"`, and `data-theme=\"dark\"`).",
      "Do keep touch targets at least 44px and keep the primary action in the pinned bottom bar."
    ],
    "donts": [
      "Don't box board rows into rounded cards on a grey ground, or use pill-filled tabs; that is the stock scoreboard this world replaces.",
      "Don't highlight the leader with a fill, a border, a badge or a shadow; the ring is the only leader mark.",
      "Don't use the tile colours for status, emphasis or anything other than identifying a player.",
      "Don't add shadows to anything on the pad; only sheets and their controls lift.",
      "Don't set Archivo at full width or use proportional figures for scores.",
      "Don't fill tile boxes solid or give them the old raised tile edge; they are outlined in pencil."
    ]
  }
}